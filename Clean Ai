<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Clean AI</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; -webkit-tap-highlight-color: transparent; }
        body { background-color: #171717; color: #ececec; display: flex; height: 100vh; overflow: hidden; }

        /* Sidebar Drawer */
        .sidebar { width: 280px; background: #000; padding: 12px; display: flex; flex-direction: column; position: fixed; top: 0; bottom: 0; left: -280px; z-index: 1000; transition: left 0.3s ease; }
        .sidebar.active { left: 0; }
        .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 999; }
        .overlay.active { display: block; }

        .brand-header { display: flex; align-items: center; justify-content: space-between; padding: 8px 6px 14px; border-bottom: 1px solid #2f2f2f; }
        .brand-logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 18px; color: #fff; }
        .brand-icon { width: 28px; height: 28px; background: #10a37f; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #fff; }

        .new-chat-btn { margin-top: 12px; background: #212121; border: 1px solid #383838; color: #fff; padding: 12px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 500; }
        
        .chat-history { flex: 1; overflow-y: auto; margin-top: 15px; display: flex; flex-direction: column; gap: 4px; }
        .history-item { display: flex; align-items: center; justify-content: space-between; padding: 10px; font-size: 13px; color: #b4b4b4; background: transparent; border: none; border-radius: 8px; cursor: pointer; text-align: left; }
        .history-item.active, .history-item:hover { background: #212121; color: #fff; }

        /* Main Screen */
        .main-screen { flex: 1; display: flex; flex-direction: column; background: #212121; height: 100vh; }
        .top-bar { height: 50px; border-bottom: 1px solid #2f2f2f; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; background: #171717; }
        .menu-btn { background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; }

        .chat-area { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 20px; }
        .msg-row { display: flex; gap: 12px; max-width: 100%; }
        .msg-row.user { justify-content: flex-end; }
        
        .avatar { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; flex-shrink: 0; }
        .avatar.ai { background: #10a37f; color: #fff; }
        .avatar.user { background: #5436da; color: #fff; }

        .msg-content { max-width: 85%; padding: 10px 14px; border-radius: 14px; font-size: 15px; line-height: 1.5; word-break: break-word; }
        .user .msg-content { background: #2f2f2f; color: #fff; border-bottom-right-radius: 2px; }
        .ai .msg-content { background: transparent; color: #ececec; border-bottom-left-radius: 2px; padding-left: 0; }

        /* Code Block */
        .code-box { background: #0d0d0d; border: 1px solid #333; border-radius: 8px; margin-top: 8px; overflow: hidden; }
        .code-head { display: flex; justify-content: space-between; padding: 6px 12px; background: #171717; font-size: 11px; color: #888; }
        .copy-btn { background: none; border: none; color: #888; cursor: pointer; font-size: 11px; }
        pre { padding: 10px; overflow-x: auto; color: #00f0ff; font-family: monospace; font-size: 13px; }

        /* Input Area */
        .input-area { padding: 12px; background: #212121; }
        .input-box { background: #2f2f2f; border: 1px solid #424242; border-radius: 24px; padding: 8px 14px; display: flex; align-items: center; }
        textarea { flex: 1; background: transparent; border: none; outline: none; color: #fff; font-size: 15px; resize: none; height: 22px; max-height: 100px; }
        .send-btn { background: #10a37f; border: none; color: #fff; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; margin-left: 8px; }
    </style>
</head>
<body>

    <div class="overlay" id="overlay" onclick="toggleMenu()"></div>

    <!-- Sidebar Drawer -->
    <div class="sidebar" id="sidebar">
        <div class="brand-header">
            <div class="brand-logo"><div class="brand-icon">C</div> Clean AI</div>
            <i class="fa-solid fa-xmark" onclick="toggleMenu()" style="cursor:pointer;"></i>
        </div>
        <button class="new-chat-btn" onclick="startNewChat()"><i class="fa-solid fa-plus"></i> New chat</button>
        <div class="chat-history" id="historyList"></div>
    </div>

    <!-- Main App Screen -->
    <div class="main-screen">
        <div class="top-bar">
            <button class="menu-btn" onclick="toggleMenu()"><i class="fa-solid fa-bars"></i></button>
            <div style="font-weight: 600; font-size: 16px;">Clean AI</div>
            <div style="width: 20px;"></div>
        </div>

        <div class="chat-area" id="chatArea">
            <div class="msg-row ai">
                <div class="avatar ai">C</div>
                <div class="msg-content">Hello! Main **Clean AI** hoon. Aaj main aapki kya madad kar sakta hoon?</div>
            </div>
        </div>

        <div class="input-area">
            <div class="input-box">
                <textarea id="userInput" placeholder="Message Clean AI..." rows="1" onkeydown="handleKey(event)"></textarea>
                <button class="send-btn" onclick="sendMsg()"><i class="fa-solid fa-arrow-up"></i></button>
            </div>
        </div>
    </div>

    <script>
        let chats = JSON.parse(localStorage.getItem('clean_ai_chats')) || [{ id: Date.now(), title: 'General Chat', msgs: [] }];
        let activeId = chats[0].id;

        function toggleMenu() {
            document.getElementById("sidebar").classList.toggle("active");
            document.getElementById("overlay").classList.toggle("active");
        }

        function renderHistory() {
            const list = document.getElementById("historyList");
            list.innerHTML = "";
            chats.forEach(c => {
                const btn = document.createElement("button");
                btn.className = `history-item ${c.id === activeId ? 'active' : ''}`;
                btn.innerText = c.title;
                btn.onclick = () => { activeId = c.id; renderChat(); toggleMenu(); };
                list.appendChild(btn);
            });
        }

        function startNewChat() {
            const newId = Date.now();
            chats.unshift({ id: newId, title: 'New Conversation', msgs: [] });
            activeId = newId;
            saveStorage();
            renderHistory();
            renderChat();
            toggleMenu();
        }

        function handleKey(e) {
            if(e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMsg(); }
        }

        function sendMsg() {
            const input = document.getElementById("userInput");
            const txt = input.value.trim();
            if(!txt) return;

            let cur = chats.find(c => c.id === activeId);
            if(cur.msgs.length === 0) { cur.title = txt.length > 20 ? txt.substring(0, 20)+'...' : txt; renderHistory(); }

            cur.msgs.push({ role: 'user', text: txt });
            input.value = "";
            renderChat();

            setTimeout(() => {
                let aiTxt = `Aapne poocha: "${txt}". Clean AI mobile environment me perfectly active hai!`;
                if(txt.toLowerCase().includes('code')) {
                    aiTxt = "Yeh raha aapka Android code:\n```javascript\nconsole.log('Clean AI App Loaded!');\n```";
                }
                cur.msgs.push({ role: 'ai', text: aiTxt });
                saveStorage();
                renderChat();
            }, 300);
        }

        function renderChat() {
            const area = document.getElementById("chatArea");
            area.innerHTML = "";
            let cur = chats.find(c => c.id === activeId);

            if(!cur || cur.msgs.length === 0) {
                area.innerHTML = `<div class="msg-row ai"><div class="avatar ai">C</div><div class="msg-content">Hello! Main **Clean AI** hoon. Poochiye jo puchna hai!</div></div>`;
                return;
            }

            cur.msgs.forEach(m => {
                const row = document.createElement("div");
                row.className = `msg-row ${m.role}`;
                if(m.role === 'user') {
                    row.innerHTML = `<div class="msg-content">${escapeHtml(m.text)}</div><div class="avatar user">U</div>`;
                } else {
                    row.innerHTML = `<div class="avatar ai">C</div><div class="msg-content">${formatTxt(m.text)}</div>`;
                }
                area.appendChild(row);
            });
            area.scrollTop = area.scrollHeight;
        }

        function formatTxt(txt) {
            let f = escapeHtml(txt);
            f = f.replace(/```(\w*)\n([\s\S]*?)```/g, '<div class="code-box"><div class="code-head"><span>CODE</span><button class="copy-btn" onclick="copyC(this)">Copy</button></div><pre><code>$2</code></pre></div>');
            f = f.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');
            f = f.replace(/\n/g, '<br>');
            return f;
        }

        function copyC(btn) {
            let code = btn.parentElement.nextElementSibling.innerText;
            navigator.clipboard.writeText(code);
            btn.innerText = "Copied!";
            setTimeout(() => btn.innerText = "Copy", 1500);
        }

        function escapeHtml(t) { return t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
        function saveStorage() { localStorage.setItem('clean_ai_chats', JSON.stringify(chats)); }

        renderHistory();
        renderChat();
    </script>
</body>
</html>
